{
	"app-id": "ca.vtrlx.Parchment.Devel",
	"runtime": "org.gnome.Platform",
	"runtime-version": "49",
	"sdk": "org.gnome.Sdk",
	"command": "parchment",
	"finish-args": [
		"--device=dri",
		"--share=ipc",
		"--socket=fallback-x11",
		"--socket=wayland",
		"--filesystem=home",
		"--persist=home"
	],
	"modules": [{
		"name": "lua",
		"no-autogen": true,
		"make-install-args": ["INSTALL_TOP=/app"],
		"sources": [{
			"type": "archive",
			"url": "https://lua.org/ftp/lua-5.4.7.tar.gz",
			"sha256": "9fbf5e28ef86c69858f6d3d34eccc32e911c1a28b4120ff3e84aaa70cfbf1e30"
		}]
	}, {
		"name": "lfs",
		"no-autogen": true,
		"make-args": ["LUA_VERSION=5.4"],
		"make-install-args": ["LUA_VERSION=5.4", "PREFIX=/app"],
		"sources": [{
			"type": "git",
			"url": "https://github.com/lunarmodules/luafilesystem",
			"tag": "v1_8_0",
			"commit": "7c6e1b013caec0602ca4796df3b1d7253a2dd258"
		}]
	}, {
		"name": "LuaGObject",
		"no-autogen": true,
		"subdir": "LuaGObject",
		"make-install-args": ["LUA_VERSION=5.4", "PREFIX=/app"],
		"sources": [{
			"type": "git",
			"url": "https://github.com/vtrlx/LuaGObject",
			"tag": "0.10.2"
		}]
	}, {
		"name": "parchment",
		"no-autogen": true,
		"make-args": ["DEVEL=true"],
		"make-install-args": ["DEVEL=true"],
		"sources": [{
			"type": "dir",
			"path": "."
		}]
	}]
}
